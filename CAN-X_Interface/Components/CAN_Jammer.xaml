<UserControl x:Class="CAN_X_CAN_Analyzer.Components.CAN_Jammer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CAN_X_CAN_Analyzer.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top"  Margin="5">
                <Grid.RowDefinitions>
                    <!-- Buttons 0 -->
                    <RowDefinition Height="40"/>
                    <!-- Datagrid 1 -->
                    <RowDefinition Height="*"/>
                    <!-- Description 2 -->
                    <RowDefinition Height="60"/>
                    <!-- Separator 3 -->
                    <RowDefinition Height="5"/>
                    <!-- Bits toggle row 4 -->
                    <RowDefinition Height="60"/>
                    <!-- Separator 5 -->
                    <RowDefinition Height="5"/>
                    <!-- Bits high row 6 -->
                    <RowDefinition Height="60"/>
                    <!-- Separator 7 -->
                    <RowDefinition Height="5"/>
                    <!-- Bits low row 8 -->
                    <RowDefinition Height="60"/>
                    <!-- Separator 9 -->
                    <RowDefinition Height="5"/>
                    <!-- Bytes row 10 -->
                    <RowDefinition Height="70"/> 
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="White" >
                    <TextBlock Text="CAN Jammer" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button x:Name="ButtonAddCAN_JamRow" Width="25" Height="25"  Margin="20,0,0,0" FontSize="18" FontWeight="Bold" Background="{x:Null}" BorderBrush="{x:Null}" Click="ButtonAddCAN_JamRow_Click">
                        <Image Source="../Resources/icons8-plus-64.png" />
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                Add Message
                                </TextBlock>
                                <TextBlock>
                    Adds a new message row
                                </TextBlock>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="ButtonDeleteCAN_JamRow" Width="25" Height="25"  Margin="5,0,0,0" FontWeight="Bold" FontSize="18" Background="{x:Null}" BorderBrush="{x:Null}" Click="ButtonDeleteCAN_JamRow_Click" >
                        <Image Source="../Resources/icons8-minus-64.png" />
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                Delete Message
                                </TextBlock>
                                <TextBlock>
                Select an ArbID to Delete
                                </TextBlock>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="ButtonCopyCAN_JamRow" Width="25" Height="25"  Margin="5,0,0,0" FontWeight="Bold" FontSize="18" Background="{x:Null}" BorderBrush="{x:Null}" Click="ButtonCopyCAN_JamRow_Click" >
                        <Image Source="../Resources/icons8-copy-64.png" />
                        <Button.ToolTip>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                    Copy Message
                                </TextBlock>
                                <TextBlock>
                    Select an ArbID to Copy
                                </TextBlock>
                            </StackPanel>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="Button_UpdateCANJam" Content="Update" Height="25" Width="50" Click="Button_UpdateCANJam_Click" Margin="15,0,0,0" />
                    <Button x:Name="Button_SaveCANJam" Content="Save" Height="25" Width="50" Margin="15,0,0,0" />
                    <GroupBox x:Name="CAN1_RelayDisable" Header="CAN1 Relay Disable" Margin="15,0,0,0" IsEnabled="False" >
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CAN1_RelayDisableFalse" Content="Off" IsChecked="True" Checked="RadioButton_RelayChecked"/>
                            <RadioButton x:Name="CAN1_RelayDisableTrue" Content="On" Checked="RadioButton_RelayChecked"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="CAN2_RelayDisable" Header="CAN2 Relay Disable" Margin="15,0,0,0" IsEnabled="False" >
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CAN2_RelayDisableFalse" Content="Off" IsChecked="True" Checked="RadioButton_RelayChecked"/>
                            <RadioButton x:Name="CAN2_RelayDisableTrue" Content="On" Checked="RadioButton_RelayChecked"/>
                        </StackPanel>
                    </GroupBox>

                    <Label Content="For use with CAN Jammer Device Only. * In Development *" VerticalAlignment="Center" Margin="25,0,0,0"  />
                </StackPanel>
                <DataGrid x:Name="dataGridCAN_Jam" Grid.Row="1" Background="White" IsReadOnly="True" PreviewMouseLeftButtonDown="dataGridCAN_Jam_PreviewMouseLeftButtonDown" MouseLeftButtonUp="dataGridCAN_Jam_MouseLeftButtonUp" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Path='Key', Mode=OneWay}" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Path='Description', Mode=TwoWay}" />
                        <DataGridTextColumn Header="ArbID" Binding="{Binding Path='ArbID' , Mode=TwoWay}" />
                        <DataGridTextColumn Header="Node" Binding="{Binding Path='Node' , Mode=TwoWay}" />
                        <DataGridCheckBoxColumn Header="Jam" Binding="{Binding Path='Jam', Mode=TwoWay}" />
                        <DataGridTextColumn Header="BitsToToggle" Binding="{Binding Path='BitsToToggle', Mode=TwoWay}" />
                        <DataGridTextColumn Header="BitsToHigh" Binding="{Binding Path='BitsToHigh', Mode=TwoWay}" />
                        <DataGridTextColumn Header="BitsToLow" Binding="{Binding Path='BitsToLow', Mode=TwoWay}" />
                        <DataGridTextColumn Header="BytesToModify" Binding="{Binding Path='ByteToModify', Mode=TwoWay}" />
                        <DataGridTextColumn Header="ByteValues" Binding="{Binding Path='ByteValues', Mode=TwoWay}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="0,0,0,0" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" Margin="15,0,0,0">
                        <Label Content="Key"/>
                        <TextBox x:Name="TextBoxKey" Height="25" Width="20" MaxLength="8" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0" >
                        <Label Content="Description" />
                        <TextBox x:Name="TextBoxDescription" MaxLength="32" Height="25" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10,0,0,0">
                        <Label Content="ArbID"/>
                        <TextBox x:Name="TextBoxArbID" Height="25" CharacterCasing="Upper" MaxLength="8" TextChanged="TextBox_TextChanged_IsHex" Text="00000000" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="20,0,0,0">
                        <Label Content="Node"/>
                        <ComboBox x:Name="ComboBoxNode" SelectedIndex="0" MinHeight="25" SelectionChanged="ComboBoxNode_SelectionChanged" >
                            <ComboBoxItem Content="CAN1"/>
                            <ComboBoxItem Content="CAN2"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="15,0,0,0" >
                        <CheckBox x:Name="CheckBoxEnableJamming" Content="Jam" Checked="CheckBoxEnableJamming_Checked" Unchecked="CheckBoxEnableJamming_Checked"  />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="20,0,0,0"/>
                </Grid>
                <Separator Grid.Row="3" Margin="0,1,0,1" />
