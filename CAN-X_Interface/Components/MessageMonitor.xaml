            </Style.Triggers>
        </Style>
    </UserControl.Resources>-->
    <UserControl.Resources>
        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseInOut"/>
    </UserControl.Resources>
    <Grid>
        <DataGrid x:Name="dataGridRxWindow" ItemsSource="{Binding Values}" CanUserAddRows="True" GridLinesVisibility="None" AutoGenerateColumns="False" Margin="0,0,0,5" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MenuItemSaveRx" Header="Save to Rx" Click="MenuItemSaveRx_Click"/>
                    <MenuItem x:Name="MenuItemSaveTx" Header="Save to Tx" Click="MenuItemSaveTx_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Background>
                <ImageBrush/>
            </DataGrid.Background>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Height" Value="25"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Line" Binding="{Binding Line, Mode=OneWay, NotifyOnTargetUpdated=True}" />
                <DataGridTextColumn Header="RxCnt" Binding="{Binding RxCount, Mode=OneWay, NotifyOnTargetUpdated=True}" />
                <DataGridTextColumn Header="TxCnt" Binding="{Binding TxCount, Mode=OneWay, NotifyOnTargetUpdated=True}" />

                <DataGridTextColumn Header="TimeAbs" Binding="{Binding TimeAbs, Mode=OneWay, NotifyOnTargetUpdated=True}" />
                <DataGridTemplateColumn Header="Tx" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Height="15" Width="15">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tx}" Value="true">
                                                <Setter Property="Source" Value="/Resources/green_icon.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Err" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Height="15" Width="15">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Err}" Value="true">
                                                <Setter Property="Source" Value="/Resources/red_icon.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="RTR" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Height="15" Width="15">
                                <Image.Style>
                                    <Style TargetType="{x:Type Image}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RTR}" Value="true">
                                                <Setter Property="Source" Value="/Resources/blue_icon.png" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Description"  Binding="{Binding Description, Mode=OneWay}" />
                <DataGridTextColumn Header="IDE" Binding="{Binding IDE, Mode=OneWay}" />
                <DataGridTextColumn Header="ArbID" Binding="{Binding ArbID, Mode=OneWay}" />
                <DataGridTextColumn Header="DLC" Binding="{Binding DLC, Mode=OneWay, NotifyOnTargetUpdated=True}" />

                <DataGridTemplateColumn Header="DataBytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Resources>
                                    <Style TargetType="Run">
                                        <Style.Triggers>
                                            <!-- Flash background when this Run's binding updates -->
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation
                                                        Storyboard.TargetProperty="(TextBlock.Background).(SolidColorBrush.Color)"
                                                        From="Transparent"
                                                            To="LightGreen"
                                                        Duration="0:0:0.2"
                                                        AutoReverse="True"
                                                            EasingFunction="{StaticResource SmoothEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Resources>

                                <!-- 8 bytes (each flashes when changed) -->
                                <Run Text="{Binding Byte1, NotifyOnTargetUpdated=True}" Background="Transparent" />                              
                                <Run Text=" "/>
                                <Run Text="{Binding Byte2, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Byte3, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Byte4, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Byte5, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Byte6, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Byte7, NotifyOnTargetUpdated=True}" Background="Transparent"/>                     
                                <Run Text=" "/>
                                <Run Text="{Binding Byte8, NotifyOnTargetUpdated=True}" Background="Transparent"/>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTextColumn Header="Byte1" Binding="{Binding Byte1, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte2" Binding="{Binding Byte2, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte3" Binding="{Binding Byte3, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte4" Binding="{Binding Byte4, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte5" Binding="{Binding Byte5, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte6" Binding="{Binding Byte6, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte7" Binding="{Binding Byte7, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                <DataGridTextColumn Header="Byte8" Binding="{Binding Byte8, Mode=OneWay, NotifyOnTargetUpdated=True}" ElementStyle="{StaticResource FlashByteStyle}" />
                -->
                
                <DataGridTextColumn Header="Node" Binding="{Binding Node, Mode=OneWay}" />
                <DataGridTextColumn Header="ASCII" Binding="{Binding ASCII, Mode=OneWay}" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=OneWay}" />
            </DataGrid.Columns>
            
            <!--<DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding HexDump}"
                               FontFamily="Consolas"
                               Margin="20,4,4,4"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>-->
            
        </DataGrid>
    </Grid>
</UserControl>
